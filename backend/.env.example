# Skopiuj ten plik jako .env i zmień wartości według potrzeb:
#   cp .env.example .env
# Plik .env nie trafia do repozytorium (jest w .gitignore).

# Nazwa aplikacji widoczna w dokumentacji API (/docs)
KOPERTLY_APP_NAME="Kopertly API"

# Adres bazy danych SQLite (plik w folderze backend/)
KOPERTLY_DATABASE_URL="sqlite:///./kopertly.db"
